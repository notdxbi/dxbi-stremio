<?xml version="1.0" encoding="utf-8"?>
<!-- dx.bi for phones: what the phone app adds to dx.bi TV's manifest (src/main), which stays dx.bi TV's -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloads keep going in the background, with their progress in a notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The larger memory allowance: a 4K stream's buffer (ExoPlayer keeps ~130 MB of it in Java
         memory) took the app past 3/4 of the normal one, and Android then closed the screen under the
         player, with Stremio's page in it: watch progress stopped, and the page came back without the
         title it had open -->
    <application android:largeHeap="true">
        <!-- The player: a small window when leaving the app, and turning with the phone and its folds -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            tools:replace="android:configChanges" />

        <!-- Casting (Google's framework, started only when something is cast) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.notdxbi.dxbi.tv.CastSetup" />
        <activity
            android:name="com.google.android.gms.cast.framework.media.widget.ExpandedControllerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- How installing an update went (Updates.install) -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".DownloadsService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
