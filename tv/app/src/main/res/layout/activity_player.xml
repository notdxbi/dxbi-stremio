<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- dx.bi's controls, laid out like the player on a computer -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/title_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/controls_scrim_bottom" />

        <ImageButton
            android:id="@+id/ctl_back"
            style="@style/PlayerButton"
            android:layout_marginStart="44dp"
            android:layout_marginTop="28dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/controls_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_now"
                    style="@style/PlayerTime"
                    android:gravity="start" />

                <com.notdxbi.dxbi.tv.SeekLine
                    android:id="@+id/seek_line"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:contentDescription="Seek bar"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/time_left"
                    style="@style/PlayerTime"
                    android:gravity="end" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/controls_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/ctl_play"
                    style="@style/PlayerButton"
                    android:contentDescription="Play or pause"
                    android:src="@drawable/ic_pause" />
                <ImageButton
                    android:id="@+id/ctl_rewind"
                    style="@style/PlayerButton"
                    android:contentDescription="Back 10 seconds"
                    android:src="@drawable/ic_rewind" />
                <ImageButton
                    android:id="@+id/ctl_forward"
                    style="@style/PlayerButton"
                    android:contentDescription="Forward 10 seconds"
                    android:src="@drawable/ic_forward" />
                <ImageButton
                    android:id="@+id/ctl_next"
                    style="@style/PlayerButton"
                    android:contentDescription="Next episode"
                    android:src="@drawable/ic_next" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controls_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="300dp"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="300dp"
                        android:maxLines="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/ctl_stats"
                    style="@style/PlayerButton"
                    android:contentDescription="Stream stats"
                    android:src="@drawable/ic_stats" />
                <ImageButton
                    android:id="@+id/ctl_picture"
                    style="@style/PlayerButton"
                    android:contentDescription="Picture"
                    android:src="@drawable/ic_picture" />
                <ImageButton
                    android:id="@+id/ctl_speed"
                    style="@style/PlayerButton"
                    android:contentDescription="Playback speed"
                    android:src="@drawable/ic_speed" />
                <ImageButton
                    android:id="@+id/ctl_subtitles"
                    style="@style/PlayerButton"
                    android:contentDescription="Subtitles"
                    android:src="@drawable/ic_subtitles" />
                <ImageButton
                    android:id="@+id/ctl_audio"
                    style="@style/PlayerButton"
                    android:contentDescription="Audio"
                    android:src="@drawable/ic_audio" />
                <ImageButton
                    android:id="@+id/ctl_party"
                    style="@style/PlayerButton"
                    android:contentDescription="Watch party"
                    android:src="@drawable/ic_party"
                    android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- The menu of whichever button was pressed: subtitles, audio, speed, picture or stats -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- The time now and when this ends, with the controls -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="56dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Up next: counts down over the credits, like on a computer -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/panel_bg"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="136dp"
            android:layout_height="76dp"
            android:background="#33FFFFFF">

            <ImageView
                android:id="@+id/up_next_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/up_next_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#FF000000"
                android:shadowRadius="6"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next episode"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/up_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/up_next_play"
                    style="@style/PanelButton"
                    android:text="Play now" />

                <TextView
                    android:id="@+id/up_next_cancel"
                    style="@style/PanelButton"
                    android:layout_marginStart="8dp"
                    android:text="Watch credits" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Skip intro / recap / credits, while one is playing (times from dx.bi) -->
    <TextView
        android:id="@+id/skip_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="134dp"
        android:background="@drawable/skip_bg"
        android:focusable="true"
        android:paddingStart="26dp"
        android:paddingTop="14dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp"
        android:textColor="#FF000000"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Brief feedback for seeks made without the controls (±10 s) -->
    <TextView
        android:id="@+id/seek_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="150dp"
        android:background="@drawable/flash_bg"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
