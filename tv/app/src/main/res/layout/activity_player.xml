<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing"
        app:show_timeout="7000"
        app:show_subtitle_button="true"
        app:show_shuffle_button="false"
        app:show_next_button="false"
        app:show_previous_button="false" />

    <!-- Title over the top of the picture while the controls are showing -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/title_scrim"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- The time now and when this ends, with the controls -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="48dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:visibility="gone" />

    <!-- Skip intro / recap / credits, while one is playing (times from dx.bi) -->
    <TextView
        android:id="@+id/skip_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/skip_bg"
        android:focusable="true"
        android:paddingStart="26dp"
        android:paddingTop="14dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp"
        android:textColor="#FF000000"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Brief feedback for seeks made without the controls (±10 s) -->
    <TextView
        android:id="@+id/seek_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="150dp"
        android:background="@drawable/flash_bg"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
