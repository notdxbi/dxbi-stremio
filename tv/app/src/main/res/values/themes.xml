<resources>
    <style name="Theme.Dxbi" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="Theme.Dxbi.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:selectableItemBackground">@drawable/player_focus</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/player_focus</item>
    </style>

    <style name="PlayerButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/controls_button</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
